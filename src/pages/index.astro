---
import '@fontsource-variable/manrope';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Arrow from '../components/Arrow.astro';
import ProcessDiagram from '../components/ProcessDiagram.astro';
import Services from '../components/Services.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import { contacts, situations, steps, faqs } from '../data/content';
const title = 'Продуктовый дизайн и автоматизация бизнеса — Вадим Родберг';
const description = 'Проектирование B2B-продуктов, UX-аудит, сопровождение разработки, чат-боты и внутренние инструменты. Личный подход и прозрачный состав работ.';
const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(base, Astro.site).href : undefined;
const ogImage = canonical ? new URL('images/og.png', canonical).href : undefined;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#f7f8fa"/>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/>
    {canonical && <link rel="canonical" href={canonical}/>}
    {canonical && <link rel="sitemap" href={`${base}sitemap.xml`}/>}
    <meta property="og:type" content="website"/><meta property="og:locale" content="ru_RU"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:site_name" content="Вадим Родберг"/>
    {canonical && <meta property="og:url" content={canonical}/>}
    {ogImage && <><meta property="og:image" content={ogImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Вадим Родберг. Продуктовый дизайн и автоматизация бизнеса."/></>}
  </head>
  <body id="top">
    <Header/>
    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <div class="hero-copy"><p class="eyebrow hero-eyebrow"><span></span> Для стартапов и малого и среднего бизнеса</p><h1 id="hero-title">Проектирую цифровые продукты <span>и помогаю автоматизировать</span> работу бизнеса</h1><p class="hero-description">Разбираюсь в процессах, проектирую интерфейсы и сопровождаю реализацию. Лично веду проект, а для разработки подключаю технических специалистов.</p><div class="hero-actions"><a class="button" href={contacts.telegram} target="_blank" rel="noopener noreferrer" data-event="primary_cta" data-placement="hero">Обсудить задачу<Arrow diagonal/></a><a class="text-link secondary-link" href="#services">Посмотреть услуги и цены <span aria-hidden="true">↓</span></a></div></div>
        <ProcessDiagram/>
        <div class="hero-facts"><div><span class="fact-mark">07</span><span>лет в продуктовом<br/>дизайне</span></div><div><span class="fact-mark" aria-hidden="true">↗</span><span>Опыт в B2B, логистике<br/>и e-commerce</span></div><div><span class="fact-mark" aria-hidden="true">↳</span><span>От разбора задачи<br/>до сопровождения запуска</span></div></div>
      </section>
      <section id="tasks" class="section tasks-section" aria-labelledby="tasks-title"><div class="container"><div class="section-heading"><p class="eyebrow">01 / Ваша задача</p><div><h2 id="tasks-title">С какой задачей<br/>можно прийти</h2><p class="section-intro">Необязательно знать, какое решение вам нужно.<br/>Достаточно понимать, что сейчас не работает.</p></div></div><div class="situations">{situations.map((situation, index) => <a href={`#${situation.serviceId}`} class="situation"><span class="situation-number">0{index + 1}</span><div><h3>{situation.title}</h3><p>{situation.description}</p></div><span class="situation-target">{situation.label}<Arrow/></span></a>)}</div><p class="specialization">Чаще работаю с B2B, логистикой, торговлей, сервисами для продавцов маркетплейсов и внутренними системами. <span>Сложный процесс в другой отрасли тоже можно обсудить.</span></p></div></section>
      <Services/>
      <Experience/>
      <section id="process" class="section process-section" aria-labelledby="process-title"><div class="container"><div class="section-heading"><p class="eyebrow">04 / Процесс</p><div><h2 id="process-title">Лично веду проект.<br/><span class="muted">На каждом этапе.</span></h2><p class="section-intro">Вы понимаете, что происходит сейчас, что получите дальше и какое решение нужно принять.</p></div></div><ol class="steps">{steps.map((step, index) => <li><span class="step-number">0{index + 1}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol><p class="process-note">Для аудита или отдельного дизайн-этапа маршрут сокращается.</p><div class="responsibilities"><div><span class="label">Я, Вадим</span><p>Продуктовая логика, UX/UI, коммуникация и координация.</p></div><div><span class="label">Технические специалисты</span><p>Реализация, интеграции и техническая проверка.</p></div><div><span class="label">Вы</span><p>Доступ к контексту, данным и согласование решений.</p></div></div></div></section>
      <section class="section about-section" aria-labelledby="about-title"><div class="container about-grid"><div><p class="eyebrow">05 / Обо мне</p><div class="about-monogram" aria-hidden="true">вр<span>↗</span></div><p class="about-name">Вадим Родберг<br/><span>Независимый продуктовый дизайнер</span></p></div><div><h2 id="about-title">Сначала логика.<br/>Потом интерфейс.</h2><p class="about-lead">Я Вадим Родберг, продуктовый дизайнер с 7-летним опытом. Работал с B2B, внутренними сервисами и e-commerce. Помогаю связать задачи бизнеса, действия пользователей и возможности разработки в понятное решение.</p><p>Смотрю не только на основной путь пользователя. Проектирую роли, ограничения, ошибки и нестандартные сценарии: что произойдёт, если документ отклонён, данных не хватает или действие недоступно.</p><p>За исследование задачи, продуктовую логику, UX/UI и согласование решений отвечаю лично. Если нужна реализация, подключаю технических подрядчиков под конкретный проект.</p><a class="text-link" href={contacts.portfolio} target="_blank" rel="noopener noreferrer">Полное портфолио<Arrow diagonal/></a></div></div></section>
      <section class="section faq-section" aria-labelledby="faq-title"><div class="container faq-grid"><div><p class="eyebrow">Перед стартом</p><h2 id="faq-title">Частые<br/>вопросы</h2></div><div class="faq-list">{faqs.map(faq => <details><summary>{faq.question}<span class="plus" aria-hidden="true"></span></summary><div class="details-content"><p>{faq.answer}</p></div></details>)}</div></div></section>
      <Contact/>
    </main>
    <footer class="site-footer"><div class="container footer-inner"><div><a href="#top" class="footer-name">{contacts.name}</a><p>{contacts.tagline}</p></div><div class="footer-links"><a href={contacts.telegram} target="_blank" rel="noopener noreferrer" data-event="telegram_click">Telegram<Arrow diagonal/></a><a href={`mailto:${contacts.email}`} data-event="email_click">{contacts.email}</a><a href={contacts.portfolio} target="_blank" rel="noopener noreferrer">Портфолио<Arrow diagonal/></a></div><span class="copyright">© {new Date().getFullYear()}</span></div></footer>
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
